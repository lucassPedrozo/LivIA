# Copie para .env e preencha. O .env nunca vai para o repositorio.

# Chave do Google AI Studio, restrita a API "Generative Language".
GEMINI_API_KEY=

# ID do modelo. Confira que existe com a requisicao 3 de "CURL - Gemini.txt".
GEMINI_MODEL=gemini-3.5-flash-lite

# Substitui o marcador [CANAL_DE_SUPORTE] na base de conhecimento.
# Texto puro: sem link markdown, sem HTML. A LivIA repete exatamente isto.
CANAL_DE_SUPORTE=WhatsApp (47) 3433-5066

# Só para a bateria de comportamento (testar.py). Aponte para a HOMOLOGACAO
# com o plugin instalado — nunca para producao: a bateria gasta cota real e
# enche a tabela de atendimentos com conversa de robo.
LIVIA_URL=
